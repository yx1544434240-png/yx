/* The navigation row and the home-indicator inset have independent heights. */
.custom-tab-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; box-sizing: border-box; background: #fff; border-top: 1rpx solid #dde5dc; box-shadow: 0 -4rpx 20rpx rgba(36, 52, 46, 0.045); }
.tab-bar-content { position: relative; display: flex; height: 112rpx; box-sizing: border-box; }
.tab-bar-item { position: relative; z-index: 1; display: flex; flex: 1; min-width: 0; height: 112rpx; box-sizing: border-box; flex-direction: column; align-items: center; padding: 12rpx 0 10rpx; }
.icon-wrapper { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 48rpx; flex-shrink: 0; }
.tab-icon { display: block; width: 44rpx; height: 44rpx; }
.tab-label { display: block; margin-top: 4rpx; font-size: 26rpx; line-height: 32rpx; color: #64716a; font-weight: 500; transition: color 160ms ease; }
.tab-bar-item.is-active .tab-label { color: #176b5d; font-weight: 600; }
.tab-bar-item { transition: transform 280ms cubic-bezier(.34, 1.56, .64, 1); }
.tab-bar-item-pressed { transform: scale(.92); transition-duration: 100ms; transition-timing-function: ease-out; }
.tab-bar-item.is-active .tab-icon { animation: tab-pop 280ms cubic-bezier(.34, 1.45, .4, 1); }
@keyframes tab-pop { 0% { transform: scale(.86); } 60% { transform: scale(1.08); } 100% { transform: scale(1); } }
/* Each indicator slot is exactly one tab wide; only its transform animates. */
.tab-indicator { position: absolute; top: 12rpx; left: 0; width: 25%; height: 48rpx; pointer-events: none; transition: transform 280ms cubic-bezier(.34, 1.28, .4, 1); }
.indicator-pill { width: 72rpx; height: 48rpx; margin: 0 auto; background: #dfeee6; border-radius: 24rpx; transition: transform 280ms cubic-bezier(.34, 1.45, .4, 1); }
.tab-safe-area { height: 0; height: constant(safe-area-inset-bottom); height: env(safe-area-inset-bottom); background: #fff; pointer-events: none; }
.is-elder .tab-bar-content, .is-elder .tab-bar-item { height: 120rpx; }
.is-elder .tab-label { font-size: 30rpx; line-height: 36rpx; }
@media (prefers-reduced-motion: reduce) { .tab-indicator, .tab-label { transition: none; } }
@media (min-width: 600px) {
  .tab-bar-content { max-width: 720px; margin: 0 auto; }
  .tab-bar-content, .tab-bar-item { height: 64px; }
  .tab-bar-item { padding: 6px 0; }
  .icon-wrapper, .tab-indicator, .indicator-pill { height: 30px; }
  .icon-wrapper, .indicator-pill { width: 52px; }
  .tab-icon { width: 26px; height: 26px; }
  .tab-indicator { top: 6px; }
  .tab-label { font-size: 15px; line-height: 20px; margin-top: 2px; }
  .is-elder .tab-bar-content, .is-elder .tab-bar-item { height: 72px; }
  .is-elder .tab-label { font-size: 18px; line-height: 24px; }
}
