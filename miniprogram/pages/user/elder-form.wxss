.card-title { font-size: var(--font-section); font-weight: 600; margin-bottom: 12rpx; }
.form-item { display: flex; flex-direction: column; align-items: stretch; gap: 14rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--border-color); }
.form-item:last-of-type { border-bottom: none; }
.label-row { width: 100%; display: flex; justify-content: space-between; align-items: center; }
.label { font-size: var(--font-caption); color: var(--text-regular); font-weight: 500; }

.map-picker-btn {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 26rpx;
  background: var(--primary-soft);
  border: 1rpx solid #c2ded4;
  border-radius: 999rpx;
  font-size: var(--font-caption);
  color: var(--primary-color);
  font-weight: 550;
  min-height: 88rpx;
  transition: transform 0.15s ease, background-color 0.15s ease;
}
.map-picker-btn:active {
  transform: scale(0.97);
  background: #d6eadf;
}
.map-picker-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.coord-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--font-caption);
  color: var(--primary-color);
  background: #edf5ef;
  border: 1rpx solid #d0e7d9;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  margin-top: 14rpx;
}
.coord-check-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}
.badge-text {
  font-weight: 500;
}

.input, .picker-val, .form-textarea-addr {
  width: 100%;
  border: 1rpx solid var(--border-color);
  border-radius: 14rpx;
  background: #f7f9f5;
  font-size: var(--font-body);
  padding: 22rpx;
  line-height: 1.5;
}
.input, .picker-val {
  min-height: var(--control-height);
  height: var(--control-height);
}
.form-textarea-addr {
  min-height: 96rpx;
}
.picker-val { display: flex; align-items: center; justify-content: space-between; }
.btn-save { margin-top: 36rpx; }

.care-level-chips { display: flex; gap: 16rpx; margin-top: 12rpx; width: 100%; }
.care-level-chip { flex: 1; min-height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; border: 2rpx solid var(--color-line-soft); background: var(--color-bg-soft); font-size: var(--font-caption); color: var(--text-main); text-align: center; padding: 8rpx; box-sizing: border-box; }
.care-level-chip.is-active { background: var(--primary-color); border-color: var(--primary-color); color: #fff; }
.elder-mode .care-level-chip { min-height: 112rpx; }
.label-row { flex-wrap: wrap; gap: 16rpx; }
.coord-badge { max-width: 100%; overflow-wrap: anywhere; }
.care-level-chip { min-width: 0; }
@media (min-width: 600px) {
  .container .input, .container .picker-val { height: var(--control-height); min-height: var(--control-height); padding: 12px 16px; }
  .container .map-picker-btn, .container .care-level-chip { min-height: var(--control-height); }
}
