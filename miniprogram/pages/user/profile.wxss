/* 个人中心与照护主页 */
.profile-page { padding: 32rpx; padding-bottom: calc(var(--tab-bar-height) + 32rpx + env(safe-area-inset-bottom)); }
.profile-intro { font-size: var(--font-meta); color: var(--text-secondary); padding: 6rpx 4rpx 20rpx; }

/* 头部身份区 */
.profile-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 28rpx;
  min-height: 208rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  background: linear-gradient(115deg, #edf4ee 0%, #fafcf9 60%, #ffffff 100%);
  border: 1rpx solid #dfe8df;
  border-radius: 32rpx;
}
.profile-hero.hero-staff {
  background: linear-gradient(115deg, #eaf5f0 0%, #f7fbf9 60%, #ffffff 100%);
  border-color: #d8eade;
}
.profile-hero.hero-admin {
  background: linear-gradient(115deg, #e8f3ef 0%, #f6faf8 60%, #ffffff 100%);
  border-color: #d3e7dd;
}
.profile-avatar {
  width: 124rpx;
  height: 124rpx;
  border: 6rpx solid #fff;
  border-radius: 50%;
  background: #dfeade;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  transition: transform 180ms ease-out, opacity 180ms ease-out;
}
.profile-avatar.staff-hero-avatar { background: #dcece4; }
.profile-avatar .avatar-default-icon { height: 56rpx; width: 56rpx; }
.profile-avatar .avatar-photo { width: 100%; height: 100%; border-radius: inherit; }
.avatar-edit-badge {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--primary-color);
  border: 3rpx solid var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-edit-icon {
  width: 22rpx;
  height: 22rpx;
}
.avatar-tap {
  opacity: 0.85;
  transform: scale(0.96);
}
.profile-avatar { position: relative; z-index: 2; }
.profile-identity { position: relative; z-index: 2; flex: 1; min-width: 0; text-align: left; display: flex; flex-direction: column; align-items: flex-start; }

/* 角色专属艺术线条装饰 */
.profile-hero-deco {
  position: absolute;
  right: 10rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 270rpx;
  height: 154rpx;
  pointer-events: none;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  opacity: 0.92;
  transition: opacity 220ms ease;
}
.role-line-art {
  width: 100%;
  height: 100%;
  display: block;
}
.elder-mode .profile-hero-deco {
  opacity: 0.38;
  right: -6rpx;
}
.user-name { max-width: 100%; overflow-wrap: anywhere; font-size: var(--font-title); font-weight: 600; line-height: 1.35; color: var(--text-main); }
.user-sub { max-width: 100%; color: var(--text-secondary); font-size: var(--font-caption); margin-top: 14rpx; line-height: 1.5; }
.role-badge { display: inline-block; max-width: 100%; color: #4c6a5d; font-size: var(--font-meta); font-weight: 400; overflow-wrap: anywhere; }
.role-badge::before { content: ''; display: inline-block; width: 10rpx; height: 10rpx; margin-right: 12rpx; border-radius: 50%; background: #43846c; vertical-align: middle; }
.profile-hero .btn-logout {
  flex: 0 0 auto;
  width: auto;
  min-width: 152rpx;
  background: #edf1eb;
  color: #526456;
  font-size: var(--font-meta);
  font-weight: 500;
  height: 88rpx;
  min-height: 80rpx;
  line-height: 1.4;
  padding: 0 24rpx;
  margin: 0;
  border: 0;
  border-radius: 40rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform 160ms ease, background-color 120ms ease;
}
.btn-logout::after {
  border: none;
}
.profile-hero .btn-logout.logout-pressed {
  background: #dfe7dc;
  transform: scale(.98);
}

.profile-login { margin-bottom: 28rpx; }

/* 我的订单快捷看板卡片 */
.order-hub-card { padding: 28rpx; margin-bottom: 24rpx; }
.hub-header { min-height: 88rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid var(--border-color); }
.hub-title { font-size: var(--font-body); font-weight: 600; color: var(--text-main); }
.hub-all { font-size: var(--font-caption); color: var(--text-secondary); gap: 6rpx; }
.hub-grid { display: grid; grid-template-columns: repeat(4, 1fr); padding-top: 24rpx; text-align: center; }
.hub-item { display: flex; flex-direction: column; align-items: center; gap: 10rpx; min-height: 88rpx; padding: 8rpx 0; }
.hub-icon-wrap { width: 72rpx; height: 72rpx; border-radius: 20rpx; background: #f1f5eb; display: flex; align-items: center; justify-content: center; transition: transform var(--motion-fast), opacity var(--motion-fast); }
.hub-icon-wrap:active { background: #e5edde; transform: scale(0.95); }
.hub-icon-wrap image { width: 36rpx; height: 36rpx; }
.hub-label { font-size: var(--font-caption); color: var(--text-regular); font-weight: 500; }

/* 工作人员执业看板卡片 */
.staff-stats-card { padding: 28rpx; margin-bottom: 24rpx; }
.staff-stats-header { padding-bottom: 20rpx; border-bottom: 1rpx solid var(--border-color); }
.staff-stats-title { font-size: var(--font-body); font-weight: 600; color: var(--text-main); }
.staff-status-pill {
  font-size: var(--font-caption);
  height: 50rpx;
  line-height: 48rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-sm, 12rpx);
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
}
.staff-status-available { background: #edf7f1; color: #1b7a54; border: 1rpx solid #cbe9d6; }
.staff-status-resting { background: #f1f4f2; color: #55655e; border: 1rpx solid #d8e0db; }
.staff-status-busy { background: #fdf5eb; color: #b26815; border: 1rpx solid #fae1c3; }
.staff-stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); padding: 24rpx 0 16rpx; text-align: center; }
.staff-stat-item { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.staff-stat-item:not(:last-child) { border-right: 1rpx solid var(--border-color); }
.staff-stat-num { font-size: var(--font-title); font-weight: 700; color: var(--primary-dark); line-height: 1.2; }
.staff-stat-unit { font-size: var(--font-meta); font-weight: 400; color: var(--text-secondary); margin-left: 2rpx; }
.staff-stat-desc { font-size: var(--font-meta); color: var(--text-secondary); }
.staff-station-bar { margin-top: 16rpx; padding-top: 18rpx; border-top: 1rpx solid var(--border-color); font-size: var(--font-caption); color: var(--text-regular); }
.staff-station-bar image { width: 28rpx; height: 28rpx; margin-right: 8rpx; flex-shrink: 0; }

/* 菜单选项卡片 */
.menu-card { padding: 0 28rpx; margin-bottom: 24rpx; }
.menu-item { display: flex; align-items: center; gap: 22rpx; min-height: 132rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--border-color); }
.menu-item:last-child { border-bottom: 0; }
.menu-icon-wrap { width: 64rpx; height: 70rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; background: #f1f5eb; flex-shrink: 0; }
.menu-icon-wrap image { height: 34rpx; width: 34rpx; }
.menu-copy { flex: 1; min-width: 0; }
.menu-label { font-size: var(--font-body); font-weight: 500; color: var(--text-main); }
.menu-description { font-size: var(--font-meta); color: var(--text-secondary); margin-top: 6rpx; }
.menu-arrow { width: 26rpx; height: 26rpx; flex-shrink: 0; opacity: 0.6; }

/* 退出登录操作区 */
.profile-logout-box { margin: 32rpx 0 16rpx; }
.btn-logout-bottom {
  width: 100%;
  min-height: 88rpx;
  background: var(--bg-hover, #f1f4f0);
  color: var(--text-secondary);
  border: 1.5rpx solid #dce2da;
  border-radius: var(--radius-md, 20rpx);
  font-size: var(--font-body);
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-logout-bottom:active {
  background: #e4ece2;
  color: var(--danger-color);
}

/* 页脚说明 */
.profile-footer { text-align: center; color: var(--text-secondary); padding: 40rpx 0 20rpx; font-size: var(--font-meta); line-height: 1.9; }
.profile-footer-name { font-size: var(--font-caption); color: #51684b; font-weight: 550; margin-bottom: 4rpx; }

/* 关爱适老模式适配 */
.elder-mode .profile-hero { gap: 24rpx; }
.elder-mode .profile-avatar { width: 132rpx; height: 132rpx; }
.elder-mode .menu-item { gap: 18rpx; padding: 28rpx 0; }
.elder-mode .hub-grid { gap: 12rpx; }
.elder-mode .hub-icon-wrap { width: 84rpx; height: 84rpx; }
.elder-mode .hub-icon-wrap image { width: 44rpx; height: 44rpx; }

.hub-icon-wrap { position: relative; }
.hub-badge { position: absolute; top: -6rpx; right: -8rpx; min-width: 30rpx; height: 30rpx; padding: 0 6rpx; border: 2rpx solid #fff; border-radius: 999rpx; background: var(--danger-color); color: #fff; font-size: 20rpx; font-weight: 500; line-height: 1; display: flex; align-items: center; justify-content: center; text-align: center; box-sizing: border-box; pointer-events: none; }
.elder-mode .hub-badge { min-width: 44rpx; height: 44rpx; line-height: 44rpx; border-radius: 22rpx; font-size: var(--font-meta); }

.staff-stats-header { flex-wrap: wrap; }
.staff-status-pill { height: auto; min-height: 50rpx; line-height: 1.5; padding-top: 6rpx; padding-bottom: 6rpx; white-space: normal; }
.staff-stats-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.staff-stat-item, .hub-item { min-width: 0; }
.menu-item switch { flex-shrink: 0; }
@media (min-width: 600px) {
  .profile-page .profile-hero { min-height: 152px; padding: 28px; gap: 24px; margin-bottom: 20px; border-radius: 22px; }
  .profile-page .profile-avatar { width: 88px; height: 88px; border-width: 4px; }
  .profile-page .avatar-default-icon { width: 42px; height: 42px; }
  .profile-page .avatar-edit-badge { width: 28px; height: 28px; border-width: 2px; }
  .profile-page .avatar-edit-icon { width: 16px; height: 16px; }
  .profile-page .user-sub { margin-top: 8px; }
  .profile-page .menu-card { padding: 0 24px; }
  .profile-page .menu-item { min-height: 96px; padding: 20px 0; gap: 16px; }
  .profile-page .menu-icon-wrap { width: 48px; height: 48px; border-radius: 12px; }
  .profile-page .menu-icon-wrap image { width: 26px; height: 26px; }
  .profile-page .menu-arrow { width: 20px; height: 20px; }
  .profile-page .hub-icon-wrap { width: 56px; height: 56px; }
  .profile-page .hub-icon-wrap image { width: 30px; height: 30px; }
  .profile-page .hub-item { min-height: 80px; }
  .profile-page .hub-header { min-height: 52px; padding-bottom: 16px; }
  .profile-page .hub-grid { padding-top: 20px; gap: 12px; }
  .profile-page .hub-badge { top: -4px; right: -5px; min-width: 20px; height: 20px; padding: 0 5px; border-width: 2px; font-size: 12px; }
  .profile-page.elder-mode .hub-badge { min-width: 22px; height: 22px; font-size: 13px; }
}
