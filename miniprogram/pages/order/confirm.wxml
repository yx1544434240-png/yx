<view class="container review-page scroll-content-with-bottom {{isElderMode ? 'elder-mode' : ''}}">
  <view class="card" wx:if="{{loading}}"><view class="rating-title">正在获取服务信息…</view></view>
  <view class="card" wx:elif="{{loadError}}"><view class="rating-title">{{errorMessage}}</view><button class="btn-secondary" bindtap="loadContext">重新加载</button></view>
  <block wx:elif="{{submitSuccess}}">
    <view class="card review-success">
      <view class="rating-title">感谢您的服务评价</view>
      <view class="review-note">{{followUp ? '您的意见和跟进申请已送达社区，可在订单详情或反馈记录中查看处理进度。' : '评价已保存，您可以在订单详情中查看。'}}</view>
      <button class="btn-primary" bindtap="returnToOrder">查看订单与评价</button>
      <button class="btn-secondary" bindtap="viewFeedback">查看反馈记录</button>
    </view>
  </block>
  <view class="review-layout" wx:else>
    <view class="card review-context">
      <view class="review-eyebrow">本次服务</view>
      <view class="review-context-title">{{reviewContext.service}}</view>
      <view class="review-context-meta" wx:if="{{reviewContext.staff}}">服务人员：{{reviewContext.staff}}</view>
      <view class="review-context-meta" wx:if="{{reviewContext.doneText}}">完成时间：{{reviewContext.doneText}}</view>
      <view class="review-note">请根据实际体验评价，文字补充为选填。</view>
      <view class="review-note" wx:if="{{draftRestored}}">已恢复上次未提交的内容</view>
    </view>
    <view class="review-form">
      <view class="card rating-card">
        <view class="rating-title">这次服务，您满意吗？</view>
        <view class="stars-box flex-row">
          <view class="star-item {{rating >= item ? 'active' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="*this" bindtap="setRating" data-rating="{{item}}" role="button" aria-label="{{item}}星，{{scoreDescMap[item]}}" aria-disabled="{{submitting}}">★</view>
        </view>
        <view class="score-desc">{{scoreDescMap[rating] || '请主动选择1至5星'}}</view>
        <view class="review-tags" wx:if="{{rating}}">
          <button wx:for="{{tagOptions}}" wx:key="label" class="review-tag {{item.selected ? 'is-selected' : ''}}" bindtap="toggleTag" data-label="{{item.label}}" disabled="{{submitting}}" hover-class="spring-in">{{item.label}}</button>
        </view>
      </view>
      <view class="card">
        <view class="rating-title">补充意见 <text class="review-optional">选填</text></view>
        <textarea class="comment-input" placeholder="有哪些做得好，或希望改进的地方？" value="{{content}}" bindinput="onInputContent" maxlength="200" cursor-spacing="160" disabled="{{submitting}}" />
        <view class="review-counter">{{content.length}} / 200字</view>
      </view>
      <view class="card follow-up-card" wx:if="{{rating > 0 && rating <= 2}}">
        <view class="follow-up-row"><view><view class="rating-title">需要社区协助处理吗？</view><view class="review-note">仅在您开启后创建跟进记录</view></view><switch checked="{{followUp}}" bindchange="onFollowUp" color="#176b5d" disabled="{{submitting}}" /></view>
        <block wx:if="{{followUp}}">
          <view class="review-note">请社区联系我处理 · 选择一个主要问题</view>
          <view class="review-tags"><button wx:for="{{issueOptions}}" wx:key="*this" class="review-tag {{issueType === item ? 'is-selected' : ''}}" bindtap="selectIssue" data-label="{{item}}" disabled="{{submitting}}">{{item}}</button></view>
        </block>
      </view>
    </view>
  </view>
  <view class="confirm-bottom-bar" wx:if="{{canReview && !submitSuccess}}"><button class="btn-primary btn-submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitReview">{{submitting ? '正在提交…' : (followUp ? '提交评价并申请跟进' : '提交评价')}}</button></view>
</view>