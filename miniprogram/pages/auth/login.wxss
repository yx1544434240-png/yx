page { background: #263f32; color: #fff; }
.login-page { position: relative; min-height: 100vh; background: #263f32; }
.login-background, .login-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.login-shade { pointer-events: none; background: linear-gradient(180deg, rgba(11,29,20,.34) 0%, rgba(11,29,20,.08) 30%, rgba(11,29,20,.48) 54%, rgba(11,29,20,.86) 100%); }
.login-content { position: relative; min-height: 100vh; display: flex; flex-direction: column; padding: calc(108rpx + env(safe-area-inset-top)) 48rpx calc(28rpx + env(safe-area-inset-bottom)); }
.brand-lockup { display: flex; align-items: center; gap: 20rpx; }
.brand-icon { display: block; width: 96rpx; height: 96rpx; flex-shrink: 0; border-radius: 24rpx; }
.brand-copy { min-width: 0; }
.brand-name { font-size: 44rpx; line-height: 1.2; font-weight: 650; letter-spacing: 4rpx; }
.brand-dot { color: #e3b875; }
.brand-description { font-size: 28rpx; color: #f2eee3; margin-top: 8rpx; letter-spacing: 2rpx; }
.login-spacer { flex: 1; min-height: 180rpx; }
.hero-eyebrow { font-size: 28rpx; color: #f2eee3; letter-spacing: 2rpx; margin-bottom: 22rpx; }
.hero-title { font-size: 62rpx; line-height: 1.4; font-weight: 600; letter-spacing: 2rpx; }
.hero-description { margin-top: 20rpx; font-size: 30rpx; color: #f2eee3; line-height: 1.7; }
.action-section { margin-top: 48rpx; }
.login-content .action-section .btn-quick-login { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 104rpx; margin: 0; padding: 24rpx; border: 1rpx solid rgba(255,255,255,.65); border-radius: 24rpx; background: rgba(255,255,255,.22); color: #fff; font-size: 34rpx; font-weight: 600; line-height: 1.5; transition: transform 200ms cubic-bezier(.2,.7,.2,1), background-color 120ms ease; }
.login-content .action-section .login-button-pressed { transform: scale(.98); background: rgba(255,255,255,.34); }
.login-content .btn-quick-login[disabled] { opacity: .8; color: #fff; background: rgba(255,255,255,.18); }
.agreement-section { margin-top: 18rpx; }
.agreement-row { display: flex; align-items: center; min-height: 88rpx; }
.checkbox-hit-area { display: flex; align-items: center; justify-content: flex-start; width: 60rpx; min-height: 88rpx; flex-shrink: 0; }
.custom-checkbox { width: 36rpx; height: 36rpx; border: 2rpx solid rgba(255,255,255,.85); border-radius: 10rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.08); transition: background-color 160ms ease; }
.custom-checkbox.is-checked { background: rgba(255,255,255,.28); }
.check-stroke { width: 17rpx; height: 9rpx; border-left: 4rpx solid #fff; border-bottom: 4rpx solid #fff; transform: rotate(-45deg) scale(0); }
.custom-checkbox.is-checked .check-stroke { transform: rotate(-45deg) scale(1); transition: transform 160ms ease; }
.agreement-label { font-size: 28rpx; line-height: 1.9; color: #f4f2e9; }
.doc-link { color: #fff; text-decoration: underline; }
.login-footer { padding-top: 18rpx; text-align: center; font-size: 28rpx; color: #e2e6dc; letter-spacing: 2rpx; }
.doc-scroll-content { padding: 10rpx 0; }
.doc-text { font-size: var(--font-meta); color: var(--text-regular); line-height: 1.8; white-space: pre-wrap; }
@media (max-height: 650px) {
  .login-content { padding-top: calc(96rpx + env(safe-area-inset-top)); }
  .login-spacer { min-height: 60rpx; }
  .hero-title { font-size: 54rpx; }
  .action-section { margin-top: 30rpx; }
  .hero-eyebrow { margin-bottom: 14rpx; }
}

/* 协议行移到按钮上方 */
.agreement-section { margin-top: 40rpx; }
.login-content .action-section { margin-top: 24rpx; }
.login-content { box-sizing: border-box; }
.agreement-label { flex: 1; min-width: 0; }
@media (min-width: 600px) {
  .login-content { max-width: 640px; margin: 0 auto; padding: calc(72px + env(safe-area-inset-top)) 32px calc(24px + env(safe-area-inset-bottom)); }
  .brand-lockup { gap: 16px; }
  .brand-icon { width: 64px; height: 64px; border-radius: 16px; }
  .brand-name { font-size: 32px; }
  .brand-description, .hero-eyebrow, .agreement-label, .login-footer { font-size: 18px; }
  .login-spacer { min-height: 56px; }
  .hero-title { font-size: 42px; }
  .hero-description { font-size: 20px; }
  .login-content .action-section .btn-quick-login { min-height: 60px; padding: 16px; font-size: 22px; border-radius: 16px; }
  .checkbox-hit-area { width: 44px; min-height: 56px; }
  .custom-checkbox { width: 26px; height: 26px; border-radius: 6px; }
  .check-stroke { width: 12px; height: 7px; border-width: 3px; }
  .agreement-section { margin-top: 24px; }
  .agreement-row { min-height: 56px; }
}
