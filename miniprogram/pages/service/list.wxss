page {
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  background: var(--bg-color);
}

.service-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(var(--tab-bar-height) + env(safe-area-inset-bottom));
}



.listing-header-area {
  flex-shrink: 0;
  padding: 16rpx 32rpx 0;
  background: var(--bg-color);
  z-index: 10;
}

.listing-header {
  padding: 8rpx 0 16rpx;
}

.listing-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-main);
}

.listing-caption {
  margin-top: 6rpx;
  font-size: var(--font-caption);
  color: var(--text-secondary);
}

/* 分类滑动条 */
.category-scroll {
  white-space: nowrap;
  width: 100%;
  border-bottom: 2rpx solid #e0e5de;
}

.category-bar {
  display: inline-flex;
  position: relative;
  min-width: 100%;
  padding-bottom: 6rpx;
}

.cat-nav-item {
  flex: 0 0 var(--swipe-tab-width);
  width: var(--swipe-tab-width);
  text-align: center;
  padding: 20rpx 10rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption);
  color: var(--text-secondary);
  position: relative;
  transition: color 0.25s ease;
}

.cat-nav-item.active {
  color: var(--primary-dark);
  font-weight: 600;
}

/* 平滑滑动指示条 */
.cat-slider {
  position: absolute;
  bottom: 0;
  left: 0;
  width: var(--swipe-tab-width);
  height: 6rpx;
  transition: transform var(--motion-standard) var(--motion-ease);
}
.cat-slider.is-live { transition: none; }
.slider-line { width: 44rpx; height: 6rpx; margin: 0 auto; background: var(--primary-color); border-radius: 4rpx; }

/* Swiper 滑动区域 */
.service-swiper {
  flex: 1 1 0%;
  height: 0;
  min-height: 0;
  width: 100%;
}

.swiper-page-item {
  height: 100%;
}

.service-scroll {
  height: 100%;
  box-sizing: border-box;
}

.service-list-content {
  padding: 24rpx 32rpx 32rpx;
}

.service-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: none;
}

.service-card-main {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
}

.service-picture {
  flex-shrink: 0;
  display: block;
  width: 156rpx;
  height: 132rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #eef3e7;
  position: relative;
}

.service-picture service-photo,
.service-picture .service-photo,
.service-picture image {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
}

.service-copy {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: var(--font-section);
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-main);
}

.item-desc {
  color: var(--text-secondary);
  font-size: var(--font-caption);
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.service-meta {
  margin-top: 14rpx;
  font-size: var(--font-meta);
  color: #5b7250;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--border-color);
}

.item-price {
  font-size: var(--font-display);
  font-weight: 600;
  color: var(--price-color);
}

.price-unit {
  color: var(--text-secondary);
  font-size: var(--font-meta);
}

.book-button,
button.book-button {
  margin: 0;
  width: auto !important;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  font-size: var(--font-body);
  font-weight: 550;
  border-radius: var(--radius-md, 20rpx);
  background: var(--primary-color);
  color: #fff;
  gap: 8rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  flex-shrink: 0;
  box-sizing: border-box;
  transition: transform 160ms ease, background-color 120ms ease;
}

.book-button::after {
  border: none;
}

.book-button image {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  filter: brightness(0) invert(1);
}

.book-button:active, .book-button.spring-in {
  background: var(--primary-dark);
  transform: scale(.97);
}

.empty-tip {
  padding: 100rpx 32rpx;
  text-align: center;
}

.empty-text {
  font-size: var(--font-caption);
  color: var(--text-secondary);
}

.retry-button {
  margin: 24rpx auto 0;
  background: var(--primary-soft);
  color: var(--primary-dark);
  font-size: var(--font-body);
  min-height: var(--control-height);
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 14rpx;
}

/* 适老模式适配 */
.elder-mode .service-card-main {
  flex-direction: column;
}

.elder-mode .service-picture {
  width: 100%;
  height: 260rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.elder-mode .item-footer {
  flex-wrap: wrap;
}

.elder-mode .book-button {
  height: var(--control-height);
  min-height: var(--control-height);
  line-height: var(--control-height);
  padding: 0 36rpx;
  font-size: var(--font-body);
  border-radius: var(--radius-md, 20rpx);
}

@media (min-width: 600px) {
  .service-page .listing-header-area, .service-page .service-list-content, .service-page .service-skeleton-list { width: 100%; max-width: 720px; margin: 0 auto; }
  .service-page .listing-header-area { padding: 16px 24px 0; }
  .service-page .service-list-content { padding: 20px 24px; }
  .service-page .service-picture { width: 116px; height: 100px; }
  .service-page .service-card-main { gap: 20px; }
  .service-page .item-footer { padding-top: 16px; margin-top: 16px; }
  .service-page .book-button,
  .service-page button.book-button {
    width: auto !important;
    min-width: 140px;
    height: 48px;
    min-height: 48px;
    line-height: 48px;
    padding: 0 22px;
    font-size: 16px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .service-page .book-button image {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .service-page .cat-nav-item { padding: 14px 8px; min-height: 52px; }
}
