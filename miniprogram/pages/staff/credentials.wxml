<view class="container credential-page {{isElderMode ? 'elder-mode' : ''}}">
  <view class="section-title">我的资质证明</view><view class="credential-note">上传清晰的资格证书或培训证明，审核通过后才计入专业技能。</view>
  <view class="card" wx:if="{{loadError}}"><view>资质信息加载失败</view><button class="btn-secondary" bindtap="load">重新加载</button></view>
  <view wx:elif="{{loading}}" class="card">正在获取资质记录…</view>
  <view class="credential-layout" wx:else>
    <view class="card credential-form">
      <view class="credential-title">{{form.id ? '补充退回的申请' : '提交新的资质'}}</view>
      <view class="credential-label">技能分类</view><picker range="{{options}}" range-key="label" value="{{form.skillIndex}}" bindchange="onSkillChange" disabled="{{form.id || submitting || uploading}}"><view class="credential-input">{{options[form.skillIndex].label}}　⌄</view></picker>
      <view class="credential-label">资质名称</view><input class="credential-input" value="{{form.skillName}}" data-key="skillName" bindinput="onInput" maxlength="64" placeholder="请输入证书或培训证明名称" disabled="{{submitting || uploading}}" />
      <view class="credential-label">证书编号</view><input class="credential-input" value="{{form.certificateNo}}" data-key="certificateNo" bindinput="onInput" maxlength="64" placeholder="请输入证书上的编号" disabled="{{submitting || uploading}}" />
      <view class="credential-label">证明图片（{{proofs.length}} / 3）</view><view class="credential-note">支持 JPG、PNG、WEBP，每张不超过5MB；仅本人和管理员可查看。</view>
      <view class="credential-proofs"><view class="credential-proof" wx:for="{{proofs}}" wx:key="url"><image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFill" bindtap="previewProof" data-index="{{index}}" /><text wx:else>图片暂不可预览</text><button class="credential-remove" bindtap="removeProof" data-index="{{index}}" disabled="{{uploading || submitting}}">移除</button></view><button wx:if="{{proofs.length < 3}}" class="credential-add" bindtap="chooseProofs" disabled="{{uploading || submitting}}">{{uploading ? '正在上传…' : '＋ 添加图片'}}</button></view>
      <button class="btn-primary credential-submit" bindtap="submit" loading="{{submitting}}" disabled="{{submitting || uploading}}">{{form.id ? '重新提交审核' : '提交审核'}}</button><button wx:if="{{form.id}}" class="btn-secondary" bindtap="resetForm" disabled="{{submitting || uploading}}">取消补充</button>
    </view>
    <view class="credential-history"><view class="credential-title">已提交的资质</view><view class="credential-note" wx:if="{{!records.length}}">暂未提交，您可以在此上传材料。</view>
      <view class="card credential-record" wx:for="{{records}}" wx:key="id"><view class="credential-record-heading"><text class="credential-title">{{item.skillName}}</text><text class="tag {{item.auditStatus === 'APPROVED' ? 'tag-success' : 'tag-warning'}}">{{item.statusText}}</text></view><view class="credential-note">证书编号：{{item.certificateNo || '未填写'}}</view><view class="credential-note" wx:if="{{item.submittedAt}}">提交时间：{{item.submittedText}}</view><view class="credential-note" wx:else>由社区管理员录入</view><view class="credential-reason" wx:if="{{item.auditReason}}">审核意见：{{item.auditReason}}</view><view class="credential-note" wx:if="{{item.auditTime}}">审核时间：{{item.auditText}}</view><view class="credential-actions"><button wx:if="{{item.proofUrls.length}}" class="btn-secondary" bindtap="previewRecord" data-id="{{item.id}}">查看材料</button><button wx:if="{{item.auditStatus === 'REJECTED'}}" class="btn-primary" bindtap="editRejected" data-id="{{item.id}}" disabled="{{uploading || submitting}}">补充材料</button></view></view>
    </view>
  </view>
</view>
