.credential-note { font-size: var(--font-meta); color: var(--text-secondary); line-height: 1.7; margin: 12rpx 0 20rpx; overflow-wrap: anywhere; }
.credential-layout { margin-top: 28rpx; }
.credential-title { font-size: var(--font-section); color: var(--text-main); font-weight: 600; }
.credential-label { font-size: var(--font-caption); margin: 24rpx 0 12rpx; }
.credential-input { display: block; width: 100%; height: var(--control-height); min-height: var(--control-height); padding: 18rpx; font-size: var(--font-body); border: 1rpx solid var(--border-color); border-radius: 14rpx; background: var(--color-bg-soft); }
.credential-proofs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.credential-proof { min-width: 0; padding: 10rpx; border: 1rpx solid var(--border-color); border-radius: 16rpx; }
.credential-proof image { display: block; width: 100%; height: 160rpx; border-radius: 12rpx; }
.credential-proof > text { font-size: var(--font-meta); }
button.credential-remove { width: 100%; margin: 6rpx 0 0; min-height: 88rpx; border: 0; font-size: var(--font-meta); color: var(--danger-color); background: transparent; }
.credential-add { margin: 0; width: 100%; min-height: 180rpx; background: var(--primary-soft); color: var(--primary-dark); border: 1rpx dashed var(--primary-color); border-radius: 16rpx; font-size: var(--font-caption); }
button.credential-submit { width: 100%; margin: 28rpx 0 16rpx; }
.credential-record-heading, .credential-actions { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.credential-record-heading { justify-content: space-between; }
.credential-record { margin-top: 24rpx; }
.credential-reason { padding: 18rpx; border-radius: 12rpx; font-size: var(--font-caption); background: var(--primary-soft); overflow-wrap: anywhere; }
.credential-actions button { flex: 1; margin: 16rpx 0 0; min-width: 0; }
.credential-form, .credential-history { min-width: 0; }
@media (min-width: 600px) {
  .credential-page .credential-input { padding: 12px 16px; border-radius: 10px; }
  .credential-page .credential-proof image { height: 120px; }
  .credential-page .credential-remove { min-height: 44px; }
  .credential-page .credential-add { min-height: 140px; }
}
@media (min-width: 900px) {
  .container.credential-page { max-width: 1080px; }
  .credential-layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 24px; align-items: start; }
}
