/* 颐邻：社区服务界面的共享颜色、字号和交互规格 */
page {
  --primary-color: #176b5d;
  --primary-dark: #105246;
  --primary-soft: #eaf3ee;
  --secondary-color: #28785b;
  --warning-color: #94601b;
  --danger-color: #b83a3a;
  --price-color: #ad652f;
  --text-main: #24342e;
  --text-regular: #46574e;
  --text-secondary: #56635c;
  --border-color: #e3e9e2;
  --bg-color: #f6f7f3;
  --color-surface: #ffffff;
  --color-line-soft: #e0e7d9;
  --color-bg-soft: #f6f8f3;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 24rpx;
  --radius-pill: 999rpx;
  --font-body: 32rpx;
  --font-title: 42rpx;
  --font-section: 36rpx;
  --font-caption: 30rpx;
  --font-meta: 28rpx;
  --font-display: 48rpx;
  --control-height: 96rpx;
  --tab-bar-height: 112rpx;
  background: var(--bg-color);
  color: var(--text-main);
  font-size: var(--font-body);
  line-height: 1.6;
  font-family: 'PingFang SC', 'Microsoft YaHei', -apple-system, BlinkMacSystemFont, sans-serif;
}
view, button, input, textarea, scroll-view, swiper, swiper-item, picker { box-sizing: border-box; }
page { overflow-wrap: break-word; -webkit-text-size-adjust: 100%; }
button { font-weight: 500; line-height: 1.5; min-height: 88rpx; display: inline-flex; align-items: center; justify-content: center; white-space: nowrap; }
button:not([size='mini']) {
  width: auto;
  margin-left: 0;
  margin-right: 0;
}
button[size="mini"] {
  min-height: 88rpx;
  line-height: 1.4;
  padding: 14rpx 28rpx;
  font-size: var(--font-body);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
button::after { border: 0; }
button[disabled] { opacity: .55; }
input, textarea { color: var(--text-main); }
.elder-mode {
  --font-body: 39rpx;
  --font-title: 49rpx;
  --font-section: 44rpx;
  --font-caption: 36rpx;
  --font-meta: 32rpx;
  --font-display: 55rpx;
  --control-height: 112rpx;
  --tab-bar-height: 120rpx;
  line-height: 1.75;
}
.elder-mode button { min-height: var(--control-height); }
.elder-mode button[size="mini"] { min-height: var(--control-height); font-size: var(--font-body); }
.container { padding: 32rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.card { background: #fff; border: 1rpx solid var(--border-color); border-radius: 24rpx; padding: 30rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 14rpx rgba(36,52,46,.025); }
.flex-row { display: flex; align-items: center; }
.flex-row > view, .flex-between > view { min-width: 0; }
.flex-between { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.flex-col { display: flex; flex-direction: column; }

/* 全宽主行动按钮规范 (无论手机还是平板均充满容器) */
button.btn-block,
.btn-block,
button.active-order-cta,
.active-order-cta,
button.btn-submit,
.btn-submit,
button.btn-submit-order,
.btn-submit-order,
button.btn-save,
.btn-save,
button.btn-apply,
.btn-apply,
button.profile-login,
.profile-login,
button.btn-logout-bottom,
.btn-logout-bottom,
button.btn-add-bottom,
.btn-add-bottom,
button.btn-quick-login,
.btn-quick-login {
  width: 100% !important;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

/* 按钮分级规范 */
.btn-primary {
  display: flex;
  white-space: nowrap;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 20rpx 36rpx;
  border: 0;
  background: var(--primary-color);
  color: #fff;
  border-radius: 24rpx;
  font-size: var(--font-body);
  font-weight: 550;
  letter-spacing: 1rpx;
  box-shadow: 0 6rpx 18rpx rgba(23, 107, 93, 0.2);
  transition: transform 240ms cubic-bezier(.25, 1.4, .5, 1), background-color 120ms ease, box-shadow 120ms ease;
}
.btn-primary:active, .btn-primary.button-hover, .btn-primary.button-pressed, .btn-primary.spring-in {
  background: var(--primary-dark);
  transform: scale(.975);
  box-shadow: 0 2rpx 8rpx rgba(23, 107, 93, 0.12);
  transition-duration: 90ms;
  transition-timing-function: ease-out;
}
.btn-primary.is-danger {
  background: var(--danger-color);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(184, 58, 58, 0.22);
}
.btn-primary.is-danger:active, .btn-primary.is-danger.spring-in {
  background: #8e2c2c;
  transform: scale(.975);
  box-shadow: 0 2rpx 8rpx rgba(184, 58, 58, 0.12);
}

.btn-secondary {
  display: flex;
  white-space: nowrap;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 20rpx 36rpx;
  background: #edf5f1;
  color: var(--primary-color);
  border: 1.5rpx solid #c9e0d4;
  border-radius: 24rpx;
  font-size: var(--font-body);
  font-weight: 550;
  letter-spacing: 1rpx;
  transition: transform 240ms cubic-bezier(.25, 1.4, .5, 1), background-color 120ms ease;
}
.btn-secondary:active, .btn-secondary.button-hover, .btn-secondary.spring-in {
  background: #dbeef3;
  color: var(--primary-dark);
  transform: scale(.975);
  transition-duration: 90ms;
}

.btn-tertiary {
  display: flex;
  white-space: nowrap;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 16rpx 24rpx;
  background: transparent;
  color: var(--text-regular);
  border: 0;
  font-size: var(--font-body);
  font-weight: 500;
  transition: transform 240ms cubic-bezier(.25, 1.4, .5, 1), background-color 120ms ease;
}
.btn-tertiary:active, .btn-tertiary.button-hover, .btn-tertiary.spring-in {
  background: rgba(0,0,0,.03);
  color: var(--primary-color);
  transform: scale(.975);
}

.btn-danger {
  display: flex;
  white-space: nowrap;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 20rpx 36rpx;
  background: #fdf2f1;
  color: var(--danger-color);
  border: 1.5rpx solid #f8d3cf;
  border-radius: 24rpx;
  font-size: var(--font-body);
  font-weight: 550;
  transition: transform 240ms cubic-bezier(.25, 1.4, .5, 1), background-color 120ms ease;
}
.btn-danger:active, .btn-danger.button-hover, .btn-danger.spring-in {
  background: #fbe5e3;
  transform: scale(.975);
  transition-duration: 90ms;
}
.btn-text-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--danger-color);
  border: 0;
  font-size: var(--font-caption);
  padding: 12rpx 20rpx;
}

.btn-large {
  min-height: var(--control-height);
  font-size: var(--font-body);
}

/* 标签与状态徽标规格 */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  min-height: 44rpx;
  line-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
  vertical-align: middle;
  box-sizing: border-box;
  text-align: center;
}
.tag-success {
  background: #edf7f1;
  color: #1b7a54;
  border: 1rpx solid #cbe9d6;
}
.tag-warning {
  background: #fdf5eb;
  color: #b26815;
  border: 1rpx solid #fae1c3;
}
.tag-danger {
  background: #fdf1f0;
  color: #c4403a;
  border: 1rpx solid #fbd2cf;
}
.tag-info {
  background: #edf5f2;
  color: var(--primary-color);
  border: 1rpx solid #d0e7dc;
}
.tag-neutral {
  background: #f1f4f2;
  color: #55655e;
  border: 1rpx solid #d8e0db;
}
.tag-sm {
  height: 44rpx;
  min-height: 44rpx;
  line-height: 1;
  padding: 0 12rpx;
  font-size: 26rpx;
  border-radius: 6rpx;
}
.elder-mode .tag {
  height: 58rpx;
  min-height: 58rpx;
  line-height: 56rpx;
  font-size: 30rpx;
  padding: 0 22rpx;
  border-radius: 10rpx;
}
.section-title { font-size: var(--font-section); font-weight: 600; line-height: 1.5; margin: 36rpx 0 22rpx; color: var(--text-main); }
.ui-icon { width: 38rpx; height: 38rpx; flex-shrink: 0; }
.ui-icon-small { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.empty-tip { text-align: center; padding: 65rpx 30rpx; color: var(--text-secondary); font-size: var(--font-caption); line-height: 1.8; }
.price, .item-price, .service-price, .total-price { font-variant-numeric: tabular-nums; }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

/* Native swiper handles the scene transition; CSS moves only the small indicator. */
page { --swipe-tab-width: 144rpx; --motion-fast: 120ms; --motion-standard: 200ms; --motion-ease: cubic-bezier(.2,.7,.2,1); }
.elder-mode { --swipe-tab-width: 168rpx; }

/* 卡片按压微反馈：以背景变化为主，缩放降为 0.99，消除夸张晃动 */
.card, .service-entry, .menu-item, .spring { transition: transform 240ms cubic-bezier(.25, 1.4, .5, 1), background-color 120ms ease; }
.card-pressed { background: #f1f6ee; }
.card-pressed, .spring-in { transform: scale(.99); transition-duration: 90ms; transition-timing-function: ease-out; }
.elder-mode .card-pressed, .elder-mode .spring-in { transform: scale(.995); }
.elder-mode .btn-primary.spring-in, .elder-mode .btn-secondary.spring-in, .elder-mode .btn-danger.spring-in { transform: scale(.985); }

/* 表单就地校验错误样式 */
.field-error { display: flex; align-items: center; gap: 8rpx; font-size: var(--font-caption); color: var(--danger-color); margin-top: 10rpx; line-height: 1.4; }
.field-error-icon { width: 26rpx; height: 26rpx; flex-shrink: 0; }

/* 页面底部避让条（防止底部悬浮栏遮挡内容） */
.scroll-content-with-bottom { padding-bottom: calc(var(--bottom-actions-offset, 220rpx) + env(safe-area-inset-bottom)); }

.retry-button { color: var(--primary-dark); background: var(--primary-soft); min-height: 88rpx; padding: 0 36rpx; font-size: var(--font-body); border-radius: 16rpx; margin-top: 20rpx; display: inline-flex; align-items: center; justify-content: center; }
.placeholder-line, .skeleton-block { height: 32rpx; border-radius: 8rpx; margin: 0; background: linear-gradient(90deg, #e4ebe3 25%, #f7faf6 50%, #e4ebe3 75%); background-size: 200% 100%; animation: skeleton-shimmer 1.1s ease-in-out infinite; }
.skeleton-title { height: 59rpx; width: 72%; }
.skeleton-price { height: 48rpx; width: 38%; margin-top: 22rpx; }
.skeleton-tag { height: 40rpx; width: 180rpx; margin-top: 22rpx; }
.skeleton-section { height: 52rpx; width: 46%; }
.skeleton-body { height: 32rpx; width: 100%; margin-top: 24rpx; }
.skeleton-short { width: 62%; }
.skeleton-banner { height: 148rpx; }
.skeleton-row { height: 72rpx; width: 100%; margin-top: 20rpx; }

/* 平板以可读宽度和物理像素排版，避免 rpx 随屏幕等比放大。 */
@media (min-width: 600px) {
  page {
    --font-meta: 16px;
    --font-caption: 18px;
    --font-body: 20px;
    --font-section: 24px;
    --font-title: 28px;
    --font-display: 32px;
    --control-height: 52px;
    --tab-bar-height: 64px;
    --swipe-tab-width: 100px;
    --radius-sm: 10px;
    --radius-md: 14px;
    --radius-lg: 18px;
  }
  .elder-mode {
    --font-meta: 19px;
    --font-caption: 22px;
    --font-body: 24px;
    --font-section: 28px;
    --font-title: 32px;
    --font-display: 36px;
    --control-height: 60px;
    --tab-bar-height: 72px;
    --swipe-tab-width: 120px;
  }
  .container.container {
    width: 100%;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 24px;
    padding-bottom: calc(var(--tab-bar-height) + 24px + env(safe-area-inset-bottom));
  }
  .card.card { padding: 24px; border-radius: 18px; margin-bottom: 20px; }
  /* 平板模式下按钮宽度与排版重置：避免微信默认 width: 184px 导致的非全宽或文字溢出折行 */
  button, button:not([size='mini']) {
    width: auto;
    margin-left: 0;
    margin-right: 0;
    white-space: nowrap;
  }
  .btn-primary:not(.btn-inline):not(.book-button):not(.btn-action):not(.tag):not(.state-view-action),
  .btn-secondary:not(.btn-inline):not(.book-button):not(.btn-action):not(.tag):not(.state-view-action),
  .btn-danger:not(.btn-inline):not(.book-button):not(.btn-action):not(.tag):not(.state-view-action) {
    padding: 14px 24px;
    border-radius: 14px;
    white-space: nowrap;
  }
  button.btn-block,
  .btn-block,
  button.active-order-cta,
  .active-order-cta,
  button.btn-submit,
  .btn-submit,
  button.btn-submit-order,
  .btn-submit-order,
  button.btn-save,
  .btn-save,
  button.btn-apply,
  .btn-apply,
  button.profile-login,
  .profile-login,
  button.btn-logout-bottom,
  .btn-logout-bottom,
  button.btn-add-bottom,
  .btn-add-bottom,
  button.btn-quick-login,
  .btn-quick-login {
    width: 100% !important;
    display: flex;
    justify-content: center;
  }
  .ui-icon { width: 26px; height: 26px; }
  .ui-icon-small { width: 20px; height: 20px; }
  .tag.tag { height: auto; min-height: 28px; padding: 4px 10px; font-size: 15px; line-height: 1.4; white-space: normal; border-radius: 6px; }
  .elder-mode .tag.tag { font-size: 18px; }
}
@keyframes skeleton-shimmer { from { background-position: 100% 0; } to { background-position: -100% 0; } }
.page-state-tip, .detail-refresh-tip { color: var(--text-secondary); font-size: var(--font-caption); text-align: center; }
@media (prefers-reduced-motion: reduce) {
  view, button, image { transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
}
