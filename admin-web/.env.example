# 管理后台前端变量（复制为 .env.local 使用；不要放任何密钥）
# 接口前缀，默认 /api（由 nginx 或 dev 代理转发）
VITE_API_BASE=/api
# 请求超时（毫秒）
VITE_API_TIMEOUT=10000
# 开发代理目标（仅 npm run dev 使用）
VITE_PROXY_TARGET=http://localhost:8080
# 社区名称（页面展示、新建档案的默认地址/服务区域）
VITE_COMMUNITY_NAME=阳光花园社区
# 演示登录入口：生产构建禁止设为 true（构建会直接失败）
VITE_SHOW_DEMO=false
